# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/
*.egg
.venv/
venv/
ENV/
env/

# PyCharm
.idea/
.vscode/

# Logs
logs/*.log
logs/scrcpy_*.log

# Screenshots
screenshots/*.png
screenshots/*.jpg

# Config (keep the folder, ignore contents except example)
config/*.json
!config/layout_example.json

# OS
.DS_Store
Thumbs.db
desktop.ini

# Build artifacts
*.spec
dist/
build/
.coverage
coverage.xml
*.sha256

# Windows-only binaries (not used by the macOS port)
bin/*.exe
bin/*.dll
bin/*.bat
bin/*.vbs

# Temporary files
*.tmp
*.bak
~*

# Local runtime screenshots / scratch images (root-anchored so the tracked
# assets/screenshots/ folder is NOT ignored)
/images/
/screenshots/

# Local release/signing material
release/
*.p12
*.cer
*.keychain-db
